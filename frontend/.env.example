# ==============================================================================
# CADET-360 Frontend - Vite Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' inside the frontend/ directory:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# API Base URL (default is local FastAPI backend on port 8000; use '/api/v1' for Vercel/production)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase Project URL (optional; enables Google Workspace OAuth login)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (safe to expose in client-side bundles)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
