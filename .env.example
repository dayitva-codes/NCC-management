# ==============================================================================
# CADET-360: National Cadet Corps Command Platform - Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    Windows: copy .env.example .env
#    Linux/macOS: cp .env.example .env
# 2. Fill in the values appropriate for your environment (local dev, docker, or prod).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Connection Configuration
# ------------------------------------------------------------------------------
# Local SQLite fallback (default for quick zero-config local development):
DATABASE_URL=sqlite:///./ncc.db

# Production Supabase PostgreSQL Pooler (Port 6543 recommended):
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Docker-Compose local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/ncc

# ------------------------------------------------------------------------------
# 3. Security, Token Generation & Authentication
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: A 32+ character random secret string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-before-any-real-deployment

# Token signing algorithm (HS256)
ALGORITHM=HS256

# JWT token expiration time in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO wildcards if credentials used)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Supabase Cloud Configuration (Google OAuth SSO & Cloud DBMS)
# ------------------------------------------------------------------------------
# Find these in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 6. Optional AI Performance Regimen Generation (Anthropic Claude)
# ------------------------------------------------------------------------------
# Leave blank to use built-in deterministic heuristic rule engine fallback
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 7. Frontend / Vite Client Configuration (baked in during frontend build)
# ------------------------------------------------------------------------------
# Backend API Base URL (relative '/api/v1' for production reverse proxies or Vercel)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase Client Credentials for Browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
